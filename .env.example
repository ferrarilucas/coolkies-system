# ── Database (desenvolvimento) ────────────────────────────────────────────
# LOCAL (docker-compose): use a mesma URL nas duas variáveis.
# Estas são as variáveis efetivas deste arquivo — copie para .env e pronto.
DATABASE_URL="postgresql://cookies:cookies@localhost:5432/cookies"
DIRECT_URL="postgresql://cookies:cookies@localhost:5432/cookies"

# PRODUÇÃO (Supabase / serverless): o app DEVE usar o pooler em TRANSACTION
# mode (porta 6543) com connection_limit=1; as migrations usam a conexão
# DIRETA (porta 5432). Não usar o pooler em session mode (5432) no runtime —
# é o que estoura "max clients reached in session mode".
#
# DATABASE_URL="postgresql://USER:PASS@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASS@HOST.pooler.supabase.com:5432/postgres"

# BetterAuth
BETTER_AUTH_SECRET="change-me-run-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com -> Credentials -> OAuth client ID)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Banco de testes: NÃO vai neste arquivo ────────────────────────────────
# As variáveis abaixo pertencem ao arquivo `.env.test`, não a `.env`.
# Elas estão comentadas de propósito: `npm run test:db:setup` DROPA o banco
# `cookies_test`, então defini-las aqui apontaria o desenvolvimento para um
# banco que é apagado a cada rodada de testes.
#
# Conteúdo esperado de `.env.test`:
#
# DATABASE_URL="postgresql://cookies:cookies@localhost:5432/cookies_test"
# DIRECT_URL="postgresql://cookies:cookies@localhost:5432/cookies_test"

# Resend (envio do convite por e-mail)
# Sem a chave, o codigo e gerado normalmente e o convite nao e enviado.
RESEND_API_KEY=""
RESEND_FROM="Coolkies <convites@seu-dominio.com>"
